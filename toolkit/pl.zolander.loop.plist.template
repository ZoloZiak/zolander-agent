<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE: replace __USER__ with your macOS username, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pl.zolander.loop.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pl.zolander.loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/__USER__/zolander/toolkit/zolander_loop.py</string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/__USER__/zolander/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/__USER__/zolander/logs/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/__USER__/zolander</string>
</dict>
</plist>
