From b883d8117298cdecb333ed37dc1c09cbf9863e12 Mon Sep 17 00:00:00 2001
From: ZoloZiak <zoloziak@users.noreply.github.com>
Date: Sun, 23 Aug 2026 18:35:59 +0200
Subject: [PATCH] fix(agent): complete gemini proxy routing per upstream #39644
 (aux clients + Bearer auth)

---
 agent/auxiliary_client.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/agent/auxiliary_client.py b/agent/auxiliary_client.py
index 83c7fc16242..8ae22fea502 100644
--- a/agent/auxiliary_client.py
+++ b/agent/auxiliary_client.py
@@ -2200,7 +2200,9 @@ def _resolve_api_key_provider() -> Tuple[Optional[OpenAI], Optional[str]]:
         logger.debug("Auxiliary text client: %s (%s)%s", pconfig.name, model, via)
         # Native Gemini, else OpenAI-wire + Anthropic rewrap.
         base_url = _to_openai_base_url(raw_base_url)
-        if provider_id == "gemini":
+        # LOCAL MOD (Palantir google-proxy): widen the gate to the base_url shape —
+        # our provider is ``palantir-gemini`` (not the bare ``gemini`` id).
+        if provider_id == "gemini" or "/api/v2/llm/proxy/google" in str(base_url or "").lower():
             from agent.gemini_native_adapter import GeminiNativeClient, is_native_gemini_base_url
             if is_native_gemini_base_url(base_url):
                 return GeminiNativeClient(api_key=api_key, base_url=base_url), model
@@ -5286,11 +5288,13 @@ def _resolve_api_key_branch(req: _ResolveRequest, pconfig: Any, resolve_creds: C
     if profile_client is not None:
         logger.debug("resolve_provider_client: %s native client from provider profile (%s)", provider, final_model)
         return _route_client(req, profile_client, final_model)
-    if provider == "gemini":
+    # LOCAL MOD (Palantir google-proxy): widen the gate to the base_url shape —
+    # our provider is ``palantir-gemini`` (not the bare ``gemini`` id).
+    if provider == "gemini" or "/api/v2/llm/proxy/google" in str(base_url or "").lower():
         from agent.gemini_native_adapter import GeminiNativeClient, is_native_gemini_base_url
         if is_native_gemini_base_url(base_url):
             client = GeminiNativeClient(api_key=api_key, base_url=base_url)
-            logger.debug("resolve_provider_client: %s (%s)", provider, final_model)
+            logger.debug("resolve_provider_client: %s (%s) [gemini-native]", provider, final_model)
             return _route_client(req, client, final_model)
     headers = _endpoint_default_headers(base_url, provider, is_vision=req.is_vision, xai=True)
     client = _create_openai_client(api_key=api_key, base_url=base_url, **({"default_headers": headers} if headers else {}))
