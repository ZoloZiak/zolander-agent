     p = provider.strip().lower() if isinstance(provider, str) else ""
     if not p or _profile_rejects_tool_media(p, model):
         return False
@@ -456,7 +462,34 @@ def _supports_media_in_tool_results(provider: str, model: str) -> bool:
         profile = get_provider_profile(p)
         return profile is not None and bool(profile.supports_vision)
     except Exception:
-        return False
+        pass
+
+    # Custom / proxy providers: trust the wire-protocol mode declared in
+    # config.yaml. The ``api_mode`` is what determines whether tool-result
+    # image blocks are syntactically accepted, regardless of how the
+    # caller branded the provider slug. A Palantir Foundry entry with
