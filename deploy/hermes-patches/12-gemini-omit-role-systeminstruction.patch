From 283fffdd1c3850eeded4ddbfe9b4baea3ebcdfd7 Mon Sep 17 00:00:00 2001
From: ZoloZiak <zoloziak@users.noreply.github.com>
Date: Mon, 31 Aug 2026 09:46:13 +0200
Subject: [PATCH] fix(agent): omit `role` from Gemini systemInstruction for
 strict proxies

Gemini's `systemInstruction` is a Content object, but the `role` field
must be omitted. Public Google (generativelanguage / Vertex) tolerates a
stray `role: "system"` and ignores it, but strict proxy validators reject
any systemInstruction carrying `role` with HTTP 422
(`Conjure:UnprocessableEntity`). Because Hermes always sends a system
prompt, this broke every Gemini request routed through such a proxy via
the native generateContent adapter.

_build_gemini_contents now emits `{"parts": [...]}` without `role`, which
is valid on both permissive and strict Gemini surfaces.

Verified live: systemInstruction with role -> 422, without role -> 200;
GeminiNativeClient with a system prompt now returns content on
gemini-3-1-pro and gemini-3-5-flash.

Adds regression tests in test_gemini_native_adapter.py.
---
 agent/gemini_native_adapter.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/agent/gemini_native_adapter.py b/agent/gemini_native_adapter.py
index e6628f1d0f6..921ccf86c53 100644
--- a/agent/gemini_native_adapter.py
+++ b/agent/gemini_native_adapter.py
@@ -454,7 +454,14 @@ def _build_gemini_contents(
         if parts:
             contents.append({"role": "model" if role == "assistant" else "user", "parts": parts})
     joined_system = "\n".join(part for part in system_text_parts if part).strip()
-    return _merge_alternating(contents), ({"role": "system", "parts": [{"text": joined_system}]} if joined_system else None)
+    # Gemini's ``systemInstruction`` is a Content object, but the ``role``
+    # field must be omitted here. Public Google (generativelanguage / Vertex)
+    # tolerates a stray ``role: system`` and ignores it, but strict proxy
+    # validators (Palantir Foundry's Conjure layer) reject any systemInstruction
+    # carrying ``role`` with HTTP 422 ``Conjure:UnprocessableEntity`` — which,
+    # because Hermes always sends a system prompt, breaks every Gemini request
+    # on that surface. Emit just ``parts`` so the payload is valid on both.
+    return _merge_alternating(contents), ({"parts": [{"text": joined_system}]} if joined_system else None)
 
 
 def _function_declaration(tool: Any, *, json_schema: bool = False) -> Optional[Dict[str, Any]]:
