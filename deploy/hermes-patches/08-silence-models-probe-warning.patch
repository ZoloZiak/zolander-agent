From ea03a2a5b8b7c8dd311ee0d2be8c7ae864136800 Mon Sep 17 00:00:00 2001
From: ZoloZiak <zoloziak@users.noreply.github.com>
Date: Mon, 1 Jun 2026 23:42:53 +0200
Subject: [PATCH] models: silence /models probe warning for proxies known not
 to publish listings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some proxy endpoints (Palantir Foundry's LLM-proxy class) don't
implement `GET /models` on either the `/anthropic` or `/openai/v1`
surface. Hermes's `validate_requested_model` currently treats every
404 as evidence that the model name might be wrong and prints:

  ⚠  Could not verify `<model>` against this endpoint's model listing.

…on every single `/model` switch and every CLI startup that lands on
such a provider. The warning is pure noise — the model name was sourced
from the user's own config.yaml `providers:` entry, the proxy works
fine, and the only reason the probe fails is that the listing
endpoint genuinely doesn't exist.

Repeated noise trains the user to ignore the warning, which loses its
signal when the model name actually IS wrong.

Fix: add a small allow-list of host substrings whose endpoints are
documented as not implementing `/models`, and suppress the warning
(message = None) for those. Acceptance semantics are unchanged —
`anthropic_messages` is still auto-accepted, OpenAI-wire custom is
still gated on user confirmation — only the warning string is muted.

Initial allow-list:

  - palantirfoundry.   (covers both `/llm/proxy/anthropic` and
                        `/llm/proxy/openai/v1` for any region/tenant)

Three call sites covered (every branch of `validate_requested_model`
that ends in "accept anyway with warning"):

  - chat_completions probe failed → 404 / 405 / etc.
  - Anthropic Models API probe failed
  - no catalog at all (fully offline custom endpoint)

Adding a host to this allow-list requires three conditions, documented
in the source comment:

  1. the gateway runs a known proxy class that documents the missing
     endpoint
  2. models there are stable and identified via opaque internal IDs
     (so the warning's intended use — catching typos — doesn't apply)
  3. the user has expressed annoyance at the noise (so we know it's
     noise, not the only signal they had that the model name was wrong)

Verified live in a fresh CLI session — `/model palantir-claude47` and
`/model palantir-gpt54` now switch silently; the "could not verify"
banner no longer fires. Other providers' verification warnings are
unchanged.
---
 hermes_cli/models_validate.py | 40 +++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/hermes_cli/models_validate.py b/hermes_cli/models_validate.py
index 6dbcf4a424c..d5f6ab7973c 100644
--- a/hermes_cli/models_validate.py
+++ b/hermes_cli/models_validate.py
@@ -42,6 +42,38 @@ def _soft_accept(message: Optional[str]) -> dict[str, Any]:
     return _verdict(True, True, False, message)
 
 
+# Providers whose endpoints are known NOT to publish GET /models (or its Anthropic
+# equivalent). /model switches against these always trigger the "could not verify"
+# warning even though the model is valid; the warning is pure noise and trains the
+# user to ignore it. Suppress silently when the base_url matches one of these.
+#
+# Add a host here when ALL hold: the gateway runs a known proxy class that documents
+# the missing endpoint; models there are stable opaque internal IDs (so the warning's
+# typo-catching intent doesn't apply); and the user has expressed annoyance at the
+# noise. Match by substring so region/tenant subdomains all match.
+_SILENT_MODELS_PROBE_HOSTS: tuple[str, ...] = (
+    # Palantir Foundry LLM-proxy: covers BOTH /llm/proxy/anthropic
+    # (api_mode=anthropic_messages) and /llm/proxy/openai/v1 (chat_completions).
+    # Foundry's LLM-proxy class doesn't implement /v1/models on either surface;
+    # models are pinned via config.yaml providers: so the probe adds nothing.
+    "palantirfoundry.",
+)
+
+
+def _endpoint_skips_models_listing(base_url: Optional[str]) -> bool:
+    """True when this base_url is on the silent-probe allow-list. Does NOT change
+    acceptance — the model is still accepted and persisted — only mutes the warning."""
+    if not base_url:
+        return False
+    normalized = base_url.strip().lower()
+    return any(host in normalized for host in _SILENT_MODELS_PROBE_HOSTS)
+
+
+def _corrected(requested: str, corrected: str) -> dict[str, Any]:
+    return _verdict(True, True, True, f"Auto-corrected `{requested}` → `{corrected}`",
+                    corrected_model=corrected)
+
+
 # ── Catalog matching ─────────────────────────────────────────────────────
 
 @dataclass
@@ -390,6 +422,10 @@ def _validate_custom(req: _Request) -> dict[str, Any]:
         message += f"`{req.requested}` was not saved; the endpoint should expose `/models` for verification."
     if probe.get("suggested_base_url"):
         message += f"\n  If this server expects `/v1`, try base URL: `{probe.get('suggested_base_url')}`"
+    # Silent allow-list (Palantir Foundry, etc.): proxy documented not to publish
+    # /models on either surface — suppress the noise, acceptance semantics unchanged.
+    if _endpoint_skips_models_listing(req.base_url):
+        return _verdict(accepted, True, False, None)
     return _verdict(accepted, True, False, message)
 
 
@@ -538,6 +574,10 @@ def _validate_anthropic_messages(req: _Request) -> dict[str, Any]:
 
     models = _m.fetch_api_models(req.api_key, req.base_url, api_mode=req.api_mode)
     if models is None:
+        # Silent allow-list (Palantir Foundry, etc.): the proxy is known not to publish
+        # /models on this surface, so the "could not verify" warning is pure noise.
+        if _endpoint_skips_models_listing(req.base_url):
+            return _verdict(True, True, False, None)
         return _soft_accept(
             f"Note: could not verify `{req.requested}` against this endpoint's model listing.  Many "
             "Anthropic-compatible proxies do not implement GET /v1/models.  The model name has been accepted "
-- 
